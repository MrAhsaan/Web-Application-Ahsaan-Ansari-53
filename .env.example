# Copy to .env for local development if you use a dotenv loader.
# Do not commit real secrets. The application reads environment variables directly.
AUTOCARE_ENV=development
AUTOCARE_ADMIN_USER=admin
AUTOCARE_ADMIN_PASSWORD=replace-with-a-strong-password-before-first-run
AUTOCARE_SECRET=replace-with-a-long-random-secret
# Optional database path; use a persistent mounted directory in production.
# AUTOCARE_DB=/var/data/autocare.db

# Customer booking notifications (all channels are optional until configured)
AUTOCARE_NOTIFY_EMAIL=1
AUTOCARE_SMTP_HOST=smtp.example.com
AUTOCARE_SMTP_PORT=587
AUTOCARE_SMTP_USERNAME=your-smtp-username
AUTOCARE_SMTP_PASSWORD=your-smtp-password
AUTOCARE_SMTP_FROM=garage@example.com
AUTOCARE_SMTP_USE_TLS=1
# SMS + WhatsApp use Twilio. Use E.164 customer numbers such as +919876543210.
AUTOCARE_TWILIO_ACCOUNT_SID=your-twilio-account-sid
AUTOCARE_TWILIO_AUTH_TOKEN=your-twilio-auth-token
AUTOCARE_TWILIO_SMS_FROM=+10000000000
# Twilio WhatsApp sender, typically formatted as whatsapp:+14155238886 for sandbox testing
AUTOCARE_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Razorpay (use Test Mode keys during development; never commit real keys)
RAZORPAY_KEY_ID=rzp_test_TohNKD7LT3IOCN
RAZORPAY_KEY_SECRET=BH5WaiMZMDetZWJ160QWnCjp
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
AUTOCARE_HOME_VISIT_CHARGE=299.00
